# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — RC-4 found this pattern was ALSO silently swallowing
# .env.example itself (a real, committed-by-design template with no
# secrets in it — see that file's own header), meaning a fresh clone of
# this repository had zero documentation of what env vars even exist.
# The negated pattern below is required immediately after the
# exclusion (gitignore evaluates rules in order; a later un-ignore only
# works if it comes after the rule that would otherwise catch it).
.env*
!.env.example

# vercel
.vercel

# File Storage (Phase 6, Module 6.2) — local dev provider's own
# uploaded bytes, never committed, never served as a static asset.
/.storage-uploads/

# Database backups (RC-5) — real production data (including encrypted
# tenant credentials and PII); a backup archive must never be committed.
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts
