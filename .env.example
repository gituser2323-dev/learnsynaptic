# LearnSynaptic — environment variables
#
# Copy to .env.local for local development (never commit .env.local —
# .gitignore already excludes every .env* file). The app still builds
# and runs with NOTHING set below (in-memory repositories, a random
# per-process JWT secret, a no-op "console" WhatsApp/Email provider) —
# that's a deliberate, load-bearing property (see lib/startupValidation.ts),
# not an oversight. Most of this file IS required before a real
# production deploy handles real traffic or real customer data.
#
# ── Classification used throughout this file ───────────────────────────
#   [REQUIRED]      Production silently degrades to something unsafe or
#                    non-functional without it. lib/startupValidation.ts
#                    logs a loud startup error for every one of these
#                    when NODE_ENV=production and it's unset.
#   [RECOMMENDED]    Fails CLOSED already (the feature stays fully inert,
#                    never insecure) — an availability gap, not a
#                    security one, but still worth setting deliberately.
#   [PLATFORM]       One value for the whole deployment — never stored
#                    per-tenant, never entered by a customer.
#   [TENANT-AWARE]   A platform-wide DEFAULT/fallback. Any organization
#                    can override it with its own credential via
#                    Settings → Integrations (Module 8.2's encrypted
#                    tenant-credential resolver) — never required
#                    globally just because ONE tenant wants it connected.
#   [PUBLIC]         NEXT_PUBLIC_* — reaches the browser bundle by
#                    design. Never put a real secret in one of these.
#   [OPTIONAL]       The feature it backs degrades gracefully (a no-op
#                    provider, a disabled panel) when unset — not a
#                    deployment blocker at any environment tier.
#
# ── Environments ─────────────────────────────────────────────────────
# LOCAL:      this file → .env.local. In-memory DB is fine. Every secret
#             below may stay blank.
# STAGING:    its own MongoDB database (never production's), its own
#             CRON_SECRET/JWT_ACCESS_TOKEN_SECRET/encryption secrets
#             (never copy-pasted from production — see RUNBOOK.md's own
#             "Staging" section), and its own OAuth app redirect URIs/
#             webhook URLs registered against the STAGING domain, never
#             production's. WHATSAPP_PROVIDER should stay "console" (or
#             point at a vendor SANDBOX number, never a real customer-
#             facing one) so a staging bug can never message a real lead.
# PRODUCTION: every [REQUIRED] var set to a real, unique-to-production
#             value. See RUNBOOK.md for the full deploy checklist.

# ═══════════════════════════════════════════════════════════════════════
# DATABASE                                                    [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════
# Unset → every entity falls back to an in-memory dev repository (data
# does not persist across restarts, not shared across serverless
# instances — two concurrent requests can see two different
# "databases"). A real MongoDB connection string, e.g.
#   mongodb+srv://user:pass@cluster.mongodb.net/learnsynaptic
# Connection pooling (lib/db/connection.ts) is already serverless-aware
# (maxPoolSize:10, minPoolSize:0, a shared cached connection per warm
# instance) — no per-deployment tuning needed here. autoIndex is
# automatically disabled when NODE_ENV=production (see that file's own
# doc comment) — run `npm run db:sync-indexes` deliberately after a
# deploy that changes an index, never relied upon to run implicitly.
MONGODB_URI=

# ═══════════════════════════════════════════════════════════════════════
# AUTHENTICATION — platform secrets                            [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════
# Unset → a random secret is generated per process start (logged
# loudly) — tokens won't verify across restarts or multiple instances.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_TOKEN_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900                    # [OPTIONAL]
REFRESH_TOKEN_TTL_SECONDS=2592000                   # [OPTIONAL]
# "Remember Me" unchecked at login gets this shorter session lifetime.
REFRESH_TOKEN_TTL_SECONDS_SHORT=43200               # [OPTIONAL]
# Defaults to true in production, false otherwise — only set explicitly
# to override (e.g. an internal HTTP-only staging box).
AUTH_COOKIE_SECURE=                                 # [OPTIONAL]

# ── Authentication — password reset / MFA / lockout tuning ─────────────
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600               # [OPTIONAL]
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400          # [OPTIONAL]
# Per-account brute-force lockout (distinct from the per-IP rate limit
# already applied to /api/auth/login).
MAX_FAILED_LOGIN_ATTEMPTS=5                         # [OPTIONAL]
LOCKOUT_DURATION_SECONDS=900                        # [OPTIONAL]
# MFA email-OTP code lifetime, and how long a "trusted device" skips MFA.
MFA_EMAIL_OTP_TTL_SECONDS=600                       # [OPTIONAL]
MFA_TRUSTED_DEVICE_TTL_SECONDS=2592000              # [OPTIONAL]
# AES-256-GCM key encrypting every user's own TOTP secret at rest.
MFA_ENCRYPTION_SECRET=

# ── Social Login — Google real, Microsoft real, GitHub optional ────────
# [PLATFORM] Each vendor's OAuth app here is SEPARATE from the Calendar
# Connectors' own GOOGLE_OAUTH_*/MICROSOFT_OAUTH_* vars further below —
# those are per-organization-admin "connect your calendar" grants; these
# are platform-wide "log in to LearnSynaptic" identity grants, a
# different OAuth app/consent screen/redirect URI per vendor. [OPTIONAL]
# as a set — a provider with no client id/secret here simply never shows
# a "Sign in with X" button (oauth/registry.ts); none are required.
# redirectUri must exactly match what's registered on that OAuth app's
# own consent screen, e.g.
#   https://yourdomain.com/api/auth/oauth/google/callback
# — never assume localhost; set the real per-environment domain.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_REDIRECT_URI=
AUTH_MICROSOFT_TENANT_ID=common
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_REDIRECT_URI=
# Signs the OAuth `state` CSRF token and the OAuth-login MFA pending
# token.                                                    [REQUIRED]
AUTH_OAUTH_STATE_SECRET=

# ═══════════════════════════════════════════════════════════════════════
# ENCRYPTION-AT-REST SECRETS                                  [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════
# Four separate AES-256-GCM keys, one per purpose — never share one
# value across two of them (key-hygiene convention this codebase has
# held since Module 6.3: a leak of one purpose's key never compromises
# another's). Each falls back to a dev-only, checked-into-source value
# when unset (never safe for production) — lib/startupValidation.ts logs
# a loud error at boot if any is missing in a production environment.
TENANT_CREDENTIAL_ENCRYPTION_SECRET=   # every org's own integration credentials
WEBHOOK_SECRET_ENCRYPTION_SECRET=      # outbound webhook endpoint secrets
CALENDAR_TOKEN_ENCRYPTION_SECRET=      # Calendar/Meeting OAuth tokens — also
                                        # signs that flow's own OAuth `state`
# MFA_ENCRYPTION_SECRET is above, in Authentication — same tier, kept
# next to the feature it backs rather than duplicated here.

# ── Platform-only admin routes ──────────────────────────────────────────
# [PLATFORM] [RECOMMENDED] Gates the global Plan catalog + platform-only
# routes — a real secret, distinct from CRON_SECRET below despite the
# similar "no browser session" reasoning. Unset → every platform-only
# route stays fully inert (401), not an insecure default.
PLATFORM_ADMIN_SECRET=

# ═══════════════════════════════════════════════════════════════════════
# SCHEDULED JOBS / QUEUE (Vercel Cron)                        [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════
# Authenticates app/api/cron/run-due-jobs — outside the admin JWT model
# entirely, since a cron trigger has no browser session. This app's real
# queue IS the MongoDB-backed scheduler (lib/services/scheduler/),
# drained by Vercel's own cron calling this CRON_SECRET-authenticated
# route every 5 minutes (see vercel.json) — there is no separate Redis/
# worker service to configure (see CHANGELOG.md's own RC-3 entry for
# why that was evaluated and deliberately not adopted for this
# deployment). Unset → the route stays fully inert (401 on every call),
# not an insecure default — but that also means NOTHING async in this
# app fires on its own: no automation step, no scheduled WhatsApp
# campaign, no queued message send, no webhook retry.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ═══════════════════════════════════════════════════════════════════════
# OBSERVABILITY                                    [RECOMMENDED] [INFRA]
# ═══════════════════════════════════════════════════════════════════════
# One of: disabled | webhook. Unset/invalid → "disabled" — unhandled API
# errors and terminal background-job failures still reach structured
# stdout/stderr logs (this app's own real log surface, safe to ship to
# any log aggregator), just never forwarded to an external tracker
# (logged as a one-time startup warning). Set to "webhook" + a real
# collector URL to forward every captured exception as a JSON POST —
# deliberately vendor-neutral, not a specific provider's proprietary
# ingestion protocol, so any endpoint that accepts a JSON POST can sit
# behind this URL (a custom collector, an incident-management platform's
# Events API, a log-ingestion service).
ERROR_TRACKING_PROVIDER=disabled
ERROR_TRACKING_WEBHOOK_URL=
ERROR_TRACKING_SERVICE_NAME=learnsynaptic
# Set this per environment (e.g. "production" / "staging") so events
# from each are distinguishable at the collector — falls back to
# Node's own NODE_ENV, which Vercel/most platforms already set correctly.

# ── Audit log retention ─────────────────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=365                        # [OPTIONAL]

# ═══════════════════════════════════════════════════════════════════════
# FILE STORAGE (Module 6.2)                          [TENANT-AWARE-ish]
# ═══════════════════════════════════════════════════════════════════════
# One of: local | aws_s3 | cloudinary. Unset → "local" — real, working
# for local dev, but NOT SAFE FOR PRODUCTION on a serverless deployment
# like Vercel: the filesystem is read-only outside /tmp, and /tmp itself
# is neither shared across concurrent instances nor durable across
# invocations. lib/startupValidation.ts logs a loud startup error if
# this is "local" (or unset) when NODE_ENV=production. Set aws_s3 or
# cloudinary before accepting real file uploads in production. Unlike
# WhatsApp/Email/AI below, storage credentials are [PLATFORM]-only — one
# key pair for the whole deployment, not overridable per organization
# (an admin's own "Connect" button in Settings → Integrations just turns
# the ALREADY-configured provider on/off for that org, per Module 6.1's
# two-factor gate — it never collects a bucket/API key from them).
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.storage-uploads                  # local dev only — gitignored

# AWS S3 — set if STORAGE_PROVIDER=aws_s3
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
# Optional CDN/custom domain in front of the bucket — falls back to the
# bucket's own virtual-hosted-style URL when unset.
AWS_S3_PUBLIC_BASE_URL=                             # [OPTIONAL]

# Cloudinary — set if STORAGE_PROVIDER=cloudinary. Disclosed gap: private
# (authenticated) file delivery is NOT implemented for Cloudinary — use
# AWS S3 for any deployment that needs private files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Virus scanning ───────────────────────────────────────────────────────
# One of: disabled | clamav. Unset/invalid → "disabled" — uploads are
# accepted without being scanned (logged as a one-time startup warning).
# Set to clamav + point at a real clamd daemon before accepting real
# user uploads in production.                              [RECOMMENDED]
VIRUS_SCAN_PROVIDER=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# ═══════════════════════════════════════════════════════════════════════
# WHATSAPP CLOUD API                                    [TENANT-AWARE]
# ═══════════════════════════════════════════════════════════════════════
# One of: console | meta-cloud-api | aisensy | interakt | wati | gallabox
# Unset/invalid → "console" (logs instead of sending — safe everywhere,
# including staging, since it can never reach a real WhatsApp number).
# This is the DEPLOYMENT-WIDE DEFAULT provider class; any organization
# with its own real, connected Meta credentials (via Embedded Signup
# below, or manual tenant credentials in Settings → Integrations)
# automatically routes through meta-cloud-api for its own sends
# regardless of this default (resolveWhatsAppProviderForSend()) — this
# var does NOT need to be "meta-cloud-api" just because one tenant
# self-connected; it only matters for organizations relying on the
# platform's own shared default number, if any.
WHATSAPP_PROVIDER=console

# Meta Cloud API — the platform-level default credential set. [OPTIONAL]
# unless the deployment itself sends through a shared platform number
# rather than exclusively tenant-connected (Embedded Signup) numbers.
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_API_VERSION=v21.0
WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_BUSINESS_ACCOUNT_ID=                  # template-sync job

# Alternative WhatsApp providers — only needed if WHATSAPP_PROVIDER
# selects one of them.                                      [OPTIONAL]
WHATSAPP_AISENSY_API_KEY=
WHATSAPP_INTERAKT_API_KEY=
WHATSAPP_WATI_API_ENDPOINT=
WHATSAPP_WATI_ACCESS_TOKEN=
WHATSAPP_GALLABOX_API_KEY=
WHATSAPP_GALLABOX_API_SECRET=
WHATSAPP_GALLABOX_CHANNEL_ID=

# ── WhatsApp Embedded Signup (tenant self-service onboarding) ──────────
# [PLATFORM] Meta App config only — never a tenant's own WhatsApp
# credentials (those are discovered per-organization at signup time and
# stored encrypted, not here). Required for tenants to self-connect
# their own WhatsApp Business Account without an operator editing env
# vars per customer. See WHATSAPP_EMBEDDED_SIGNUP.md for the full Meta
# App Dashboard setup walkthrough. appId/configId are safe to expose to
# an authenticated admin's browser (the Facebook JS SDK needs them
# client-side, injected server-side into that one config response —
# never a NEXT_PUBLIC_* var); WHATSAPP_META_APP_SECRET above is reused,
# unchanged, for the server-side code exchange.        [OPTIONAL]
WHATSAPP_META_APP_ID=
WHATSAPP_META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_META_EMBEDDED_SIGNUP_API_VERSION=
# For real tenant-connected WABAs to actually send, WHATSAPP_PROVIDER
# above should also be meta-cloud-api (see that var's own note) — each
# organization's own discovered credentials then take effect
# automatically via the tenant-credential resolver, no per-tenant env
# editing ever.

# ── WhatsApp Campaign Manager ────────────────────────────────────────────
CAMPAIGN_CSV_IMPORT_MAX_ROWS=5000                   # [OPTIONAL]

# ═══════════════════════════════════════════════════════════════════════
# EMAIL CHANNEL                                          [TENANT-AWARE]
# ═══════════════════════════════════════════════════════════════════════
# One of: console | postmark | sendgrid | resend
# Unset/invalid → "console" (logs instead of sending). Deployment-wide
# default, same "tenant credential overrides it" shape WhatsApp uses —
# see lib/services/email/providers/postmark.provider.ts's own doc
# comment.
EMAIL_PROVIDER=console

# Postmark — the only fully-implemented vendor today; sendgrid/resend
# are disclosed scaffolds (send() throws EmailProviderNotImplementedError
# until a real implementation is built).                   [OPTIONAL]
EMAIL_POSTMARK_SERVER_TOKEN=
EMAIL_POSTMARK_FROM_ADDRESS=
# Shared secret expected as ?token= on the inbound webhook URL
# configured in Postmark's own Inbound Stream settings (Postmark
# doesn't HMAC-sign inbound requests the way Meta does).
EMAIL_POSTMARK_INBOUND_TOKEN=

EMAIL_SENDGRID_API_KEY=                             # [OPTIONAL] scaffold only
EMAIL_RESEND_API_KEY=                               # [OPTIONAL] scaffold only

# ═══════════════════════════════════════════════════════════════════════
# AI CRM (Lead Scoring, Insights, Assisted Replies)     [TENANT-AWARE]
# ═══════════════════════════════════════════════════════════════════════
# One of: openai | anthropic | gemini. Leave blank to run with every AI
# feature unavailable — the admin UI degrades gracefully (a real
# persisted "unavailable" state), never fakes a result. All three
# adapters are real (fetch-based, no SDK dependency). Deployment-wide
# default; any organization with its own tenant credential overrides it
# for its own requests.                                     [OPTIONAL]
AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ═══════════════════════════════════════════════════════════════════════
# CALENDAR & MEETING CONNECTORS (Module 6.3)                [PLATFORM]
# ═══════════════════════════════════════════════════════════════════════
# Google/Microsoft/Zoom OAuth apps — SEPARATE from the Social Login
# AUTH_GOOGLE_*/AUTH_MICROSOFT_* vars above (different consent screen,
# different scope, different redirect URI — see config/calendar.ts's
# own doc comment). One deployment-wide OAuth app per vendor; an
# organization's admin "Connect"s their OWN calendar through it (the
# resulting tokens are then encrypted and stored per-organization,
# CALENDAR_TOKEN_ENCRYPTION_SECRET above), same two-factor Integrations
# Registry gate as Storage. All [OPTIONAL] — an unconfigured vendor
# simply has no working "Connect" button for that provider.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=
MICROSOFT_OAUTH_TENANT_ID=common

ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=

# ═══════════════════════════════════════════════════════════════════════
# PAYMENTS INTEGRATION (Module 6.4)                         [PLATFORM]
# ═══════════════════════════════════════════════════════════════════════
# Each provider's credential is a single API key pair for the WHOLE
# deployment (not a per-connection secret an admin pastes) — the same
# shape Storage uses. Every provider is independently connectable
# through the Integrations Registry; a real deployment may reasonably
# run Razorpay for India and Stripe for international simultaneously.
# All [OPTIONAL] — an unconfigured provider's "Connect" button simply
# has nothing to activate.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_BASE_URL=https://api.cashfree.com/pg   # sandbox: see Cashfree's own docs

# Disclosed scaffolds — named as "(future)" providers in this module's
# own mission; catalogued and registry-wired, no real adapter built yet
# (throws PaymentProviderNotImplementedError). Safe to leave blank.
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════
# MARKETING DASHBOARD (ad spend / web analytics reporting)   [PLATFORM]
# ═══════════════════════════════════════════════════════════════════════
# Ads provider: none | meta-ads. Web analytics provider: none |
# google-analytics.                                          [OPTIONAL]
MARKETING_ADS_PROVIDER=none
MARKETING_WEB_ANALYTICS_PROVIDER=none

META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
META_ADS_API_VERSION=v21.0

GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_ANALYTICS_SERVICE_ACCOUNT_PRIVATE_KEY=

# ═══════════════════════════════════════════════════════════════════════
# PUBLIC FRONTEND CONFIGURATION                                [PUBLIC]
# ═══════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_* — reaches the browser bundle by design. Never put a real
# secret in one of these; every value below is meant to be publicly
# visible (an analytics measurement id, a public API key that's useless
# without its paired server-side secret, or a domain name).

# GA4 / Meta Pixel — unset → that provider's script never loads, no-op.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# The production origin — used by robots.txt/sitemap.xml/metadataBase
# and every JSON-LD block. Falls back to the real production domain
# when unset, so this is safe to leave blank in any environment that
# genuinely IS learnsynaptic.com; set explicitly for staging/preview
# deployments so generated URLs/OAuth-adjacent metadata point at the
# right host instead of production's.
NEXT_PUBLIC_SITE_URL=https://learnsynaptic.com

# EmailJS — secondary, client-side-only notification path for every
# lead-capture form (the backend Lead write via MONGODB_URI above is
# the real source of truth; these only control whether the team ALSO
# gets an email). Public keys by EmailJS's own design.      [OPTIONAL]
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_REGISTER_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_BOOTCAMP_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_AI_BOOTCAMP_TEMPLATE_ID=

# ═══════════════════════════════════════════════════════════════════════
# PLATFORM / INFRASTRUCTURE — set BY the platform, not in this file
# ═══════════════════════════════════════════════════════════════════════
# NODE_ENV — set automatically by Next.js (`next build`/`next start`)
# and by Vercel itself; never set manually here. Every "REQUIRED in
# production" check throughout this file only activates when
# NODE_ENV=production, matching this app's own "must still run with
# zero configuration for local dev" design.
