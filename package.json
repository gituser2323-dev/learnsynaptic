{
  "name": "learnsynaptic-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "db:migrate": "tsx --env-file=.env.local scripts/runMigrations.ts",
    "db:sync-indexes": "tsx --env-file=.env.local scripts/syncIndexes.ts",
    "preflight": "tsx --env-file=.env.local scripts/preflightCheck.ts",
    "db:backup": "tsx --env-file=.env.local scripts/db/backupDatabase.ts",
    "db:restore": "tsx --env-file=.env.local scripts/db/restoreDatabase.ts",
    "db:verify-backup": "tsx --env-file=.env.local scripts/db/verifyBackup.ts",
    "db:seed-restore-drill-fixture": "tsx --env-file=.env.local scripts/db/seedRestoreDrillFixture.ts",
    "db:verify-restore-drill": "tsx scripts/db/verifyRestoreDrillIntegrity.ts",
    "db:reconcile-files": "tsx --env-file=.env.local scripts/db/reconcileFileStorage.ts",
    "db:restore-tenant-leads": "tsx --env-file=.env.local scripts/db/restoreTenantLeadsFromExport.ts",
    "platform:bootstrap-super-admin": "tsx --env-file=.env.local scripts/bootstrapPlatformSuperAdmin.ts",
    "docs:generate-openapi": "tsx scripts/docs/generateOpenApiSpec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "@emailjs/browser": "^4.4.1",
    "@scalar/nextjs-api-reference": "^0.11.12",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.4",
    "lucide-react": "^1.22.0",
    "mongoose": "^9.8.0",
    "next": "^16.2.11",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.61.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
